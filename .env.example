# =============================================================================
# Spring PetClinic Modular REST API — Ejemplo de Variables de Entorno (.env.example)
# =============================================================================
# Nota: Este archivo contiene únicamente valores de ejemplo NO sensibles para
# entornos de desarrollo local. Por defecto, la aplicación inicia con el perfil
# en memoria H2 sin requerir variables externas.

# Perfil de Spring Boot activo: default (H2 en memoria) | mysql | postgres
SPRING_PROFILES_ACTIVE=default

# Puerto HTTP de escucha del servidor embebido Tomcat
SERVER_PORT=8080

# Configuración opcional para perfil MySQL (spring.profiles.active=mysql)
MYSQL_URL=jdbc:mysql://localhost:3306/petclinic
MYSQL_USER=petclinic
MYSQL_PASS=petclinic

# Configuración opcional para perfil PostgreSQL (spring.profiles.active=postgres)
POSTGRES_URL=jdbc:postgresql://localhost:5432/petclinic
POSTGRES_USER=petclinic
POSTGRES_PASS=petclinic

